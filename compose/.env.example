# sambuca :: compose/.env.example
#
# This file is the DECLARED DEFAULT SET. It is never used directly at runtime —
# phase 60-stack renders a real `.env` (mode 0600) from this plus the hardware
# profile plus on-device secrets.
#
# ══════════════════════════════════════════════════════════════════════════
# IMAGE PINS — READ BEFORE RELEASE
#
# Every tag below is a MUTABLE reference. Before tagging a sambuca release, run
#     make verify-images        # resolves every ref and reports its digest
#     make pin-images           # rewrites this file with @sha256: digests
#
# Digest pinning is what makes a "zero-configuration installer" reproducible.
# Without it, two machines flashed a month apart get different software from
# the same USB stick, and the GitOps sync has nothing stable to validate
# against. Tags are the development convenience; digests are the release
# artefact.
# ══════════════════════════════════════════════════════════════════════════

# --- core ---
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
POCKET_ID_IMAGE=ghcr.io/pocket-id/pocket-id:v2.5.0@sha256:1549f31f76a6c158af0056a4f2c62a590627886a84e9da9bda76eb1e142a449a
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.14.2@sha256:121cdc6520a02d7a2ddd181af6dbdc0f11f7d0c0d9353a999a69c3998cbfe37e
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:1.23.17@sha256:3d632903e6af34139a37f18055c4f1bfd9b7205ae1138f1e5e8940ddc1d176f9
# 1.7.1 is the newest release; containrrr/watchtower has been effectively
# unmaintained for some time, which is one more reason nothing stateful opts in
# to it. Registered in docs/MAINTENANCE.md Tier 3.
WATCHTOWER_IMAGE=containrrr/watchtower:1.7.1@sha256:6dd50763bbd632a83cb154d5451700530d1e44200b268a4e9488fefdfcf2b038

# --- ai ---
OLLAMA_IMAGE=ollama/ollama:0.32.15@sha256:57d60e686821ea81a7748a3ec8141308c8b8f95b27105713954abf7a6529e700
OLLAMA_ROCM_IMAGE=ollama/ollama:0.32.15-rocm@sha256:b1495fb615be87fb43fc2321be80d49069e03175a4516730f102f9b6e8727a87

# ComfyUI — the image plane. THIRD-PARTY IMAGE, and worth saying out loud:
# ComfyUI publishes no official container, so this is a community build. It is
# pinned to a dated tag rather than :latest, it goes through the same Trivy
# gate as everything else in tools/vuln-baseline.json, and the alternative —
# building our own from an upstream git tag — is tracked but not done.
# Whoever bumps this: read docs/MAINTENANCE.md first, the tag is not the only
# thing that moves.
COMFYUI_IMAGE=yanwk/comfyui-boot:cu126-slim-20260817@sha256:6bebfb60239eb396aaa40d3e612a19620a4e6f79cf13d7d1174e62b994bae315
COMFYUI_ROCM_IMAGE=yanwk/comfyui-boot:rocm-20260814@sha256:3ff8b3b0d1a5168c581a77ef79b537a53a6b21c29215d7a7880987d0bd0c031a
COMFYUI_CPU_IMAGE=yanwk/comfyui-boot:cpu-20260817@sha256:5929225fd5f3370c9f24cf9a47f0632e9cc0e607cc078cbab701634f44a545fe
# ─────────────────────────────────────────────────────────────────────────
# ODYSSEUS — THE ONE REFERENCE THAT DOES NOT RESOLVE YET.
#
# Verified 2026-08-19: this package is not anonymously pullable. Until it is
# published PUBLICLY to GHCR, an appliance cannot fetch it, `docker compose
# pull` will fail for this one service, and the `ai` bundle starts with Ollama
# but no frontend.
#
# To publish it (from the Odysseus source tree, as the org owner):
#   docker build -t ghcr.io/laboratoiresonore/odysseus:0.1.0 .
#   docker push  ghcr.io/laboratoiresonore/odysseus:0.1.0
#   gh api -X PATCH /user/packages/container/odysseus -f visibility=public
#     (a private package is not pullable by an appliance)
#
# Until then, either drop `ai` from SAMBUCA_BUNDLES, or override this with your
# own build in compose/local.yml. `tools/verify-images.py` reports this as
# UNPUBLISHED rather than BROKEN, because it is a first-party reference.
# ─────────────────────────────────────────────────────────────────────────
ODYSSEUS_IMAGE=ghcr.io/laboratoiresonore/odysseus:latest

# --- cloud ---
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.1-alpine@sha256:b094afed4ed5ea353821c6efcedca446f30c6654ba2bc441db6089b0c2b94ac8
NEXTCLOUD_AIO_IMAGE=nextcloud/all-in-one:latest
IMMICH_SERVER_IMAGE=ghcr.io/immich-app/immich-server:v1.128.0@sha256:3306cbb62e5ac5fd1449b0a92990686b6795afa7bed7fd9aec8fb81c978dec91
IMMICH_ML_IMAGE=ghcr.io/immich-app/immich-machine-learning:v1.128.0@sha256:8011358f5bd474d72b08a9dc1ad38f4c763ef0e4ebbc6012fd6141801268f141

# The GPU variants are DIFFERENT IMAGES with different digests, so they are
# pinned separately. 60-stack.sh picks one using IMMICH_ML_IMAGE_SUFFIX and
# writes the finished reference into .env. Nothing is appended at pull time —
# nothing CAN be appended to a digest, and appending was how a reference that
# resolves (the base) hid one that does not (base+suffix).
#
# There is deliberately no -rocm entry: upstream publishes no ROCm build on any
# release tag. See the AMD branch in engine/hardware-detect.sh.
IMMICH_ML_CUDA_IMAGE=ghcr.io/immich-app/immich-machine-learning:v1.128.0-cuda@sha256:31f2603391fd79f8eabe478403758aad6c17d5cf10cf961e4bb524772c208201
IMMICH_ML_OPENVINO_IMAGE=ghcr.io/immich-app/immich-machine-learning:v1.128.0-openvino@sha256:e70d5b0e98bcec9da2190a5c5534c38888f3fb729fd17cd3256cec81decb79e8
# Immich's database image changes with its vector extension, and a mismatched
# pair fails at schema migration rather than at startup. Immich's own
# docker-compose.yml is the authority. VERIFIED against v1.128.0: it still pins
# pgvecto-rs:pg14-v0.2.0, so this is correct for the server tag above. Re-check
# on every server bump.
IMMICH_DB_IMAGE=tensorchord/pgvecto-rs:pg14-v0.2.0@sha256:739cdd626151ff1f796dc95a6591b55a714f341c737e27f045019ceabf8e8c52
# VALKEY, NOT REDIS — a licensing decision, not a technical one.
# Redis changed licence at 7.4 to RSALv2/SSPLv1: source-available, and neither
# is OSI-approved. Redis 8 re-added AGPLv3 as an option, so it would also be
# acceptable. Valkey is the Linux Foundation's BSD-3-Clause fork of the last
# free Redis, is a drop-in replacement, and carries no licence ambiguity at all
# — which matters more than usual for an appliance whose entire premise is that
# you own what runs on it.
REDIS_IMAGE=valkey/valkey:9.1.1-alpine@sha256:de31910896150d5e754a07d57d227cfdde4e258ddd0d1aa4607f2d2f95843715
POSTGRES_IMAGE=postgres:16.15-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685

# --- office ---
BLINKO_IMAGE=blinkospace/blinko:1.8.8@sha256:31c3bc9f4fc00c82328c098c0c1120fe7fe43152a9f3cbc04b0303c32a2e60d3
# `bentopdf-simple` is the self-hosted build. CORRECTED after checking
# upstream: both builds carry the SAME dual licence (AGPL-3.0, or a paid
# commercial licence that removes the AGPL obligations). The difference between
# them is cosmetic — `-simple` omits the marketing site. An earlier note here
# claimed the commercial build was required for public-facing deployments,
# which was wrong. We use `-simple` under AGPL-3.0 because it is the leaner
# image, not because the other one is disallowed.
BENTOPDF_IMAGE=ghcr.io/alam00000/bentopdf-simple:v2.8.7@sha256:ba67d44f07ec0d2d636c945eef1c186f71bceda3d11b1e9809d7dbfbbaaacfa4

# --- comms ---
ERGO_IMAGE=ghcr.io/ergochat/ergo:v2.19.1@sha256:ef885e44f7fa19101bbbc41baef11dc280dc8107465dccaf6f0860f41b48a682
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.122.0@sha256:925534da6deefc83d3b82bdb08acd7bedfd34ca29f8d47a27c386c0ece9a0515

# ══════════════════════════════════════════════════════════════════════════
# Values below are OVERWRITTEN by phase 60-stack from the real machine state.
# They exist so `docker compose config` works on a developer laptop.
# ══════════════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=sambuca
COMPOSE_FILE=docker-compose.yml:ai.yml:cloud.yml:office.yml:comms.yml:gpu.cpu.ai.yml:gpu.cpu.cloud.yml
COMPOSE_PATH_SEPARATOR=:

TZ=UTC
PUID=1000
PGID=1000
SAMBUCA_DOMAIN=sambuca.local
SAMBUCA_TS_DNSNAME=
SAMBUCA_ACME_EMAIL=
CASAOS_PORT=8095
# Where the engine writes progress.json, bind-mounted into Caddy so the
# setup screen can report which step is running.
SAMBUCA_STATE=/var/lib/sambuca

SAMBUCA_DATA=/srv/sambuca
SAMBUCA_APPDATA=/srv/sambuca/appdata
SAMBUCA_MEDIA=/srv/sambuca/media
SAMBUCA_PHOTOS=/srv/sambuca/photos
SAMBUCA_FILES=/srv/sambuca/files

# Hardware profile placeholders (real values come from hardware-detect.sh).
SAMBUCA_TIER=4
SAMBUCA_GPU_PROFILE=cpu
SAMBUCA_MODEL_CHAT=llama3.2:3b-instruct-q4_K_M
SAMBUCA_MODEL_CODE=
SAMBUCA_MODEL_VISION=
SAMBUCA_MODEL_EMBED=nomic-embed-text
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_FLASH_ATTENTION=0
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MEM_LIMIT=4g

# --- image plane (written by hardware-detect.sh; these are inert defaults) ---
# SAMBUCA_IMAGE_ENABLED is decided by the MEASURED machine, not set here.
SAMBUCA_IMAGE_ENABLED=0
#
# NOT YET READ BY ANYTHING. The next two are passed to the ComfyUI container,
# which does not read SAMBUCA_* variables — they are for the orchestrator that
# would substitute them into the workflow graph, and that orchestrator is NOT
# BUILT (see the status table in the README).
#
# Said out loud because "inert defaults" reads as "overridden elsewhere", and
# somebody raising STEPS to 8 expecting slower, better pictures would get
# exactly nothing, with no way to tell why. A knob that turns and changes
# nothing is worse than no knob.
SAMBUCA_IMAGE_WORKFLOW=flux-schnell.json
SAMBUCA_IMAGE_STEPS=4
COMFYUI_VRAM_ARGS=--normalvram
COMFYUI_RESERVE_VRAM_GB=1
COMFYUI_MEM_LIMIT=12g
COMFYUI_OUTPUT_TMPFS=2g
IMMICH_ML_DEVICE=cpu
# IMMICH_ML_IMAGE_SUFFIX is deliberately NOT here. Setting it in this file
# would change nothing: 60-stack.sh resolves the ML reference once, while
# rendering .env, and a variant chosen afterwards is never consulted. It used
# to work here, back when compose concatenated base+suffix at pull time — and
# that concatenation is what let a reference nobody published (-rocm) reach an
# AMD appliance unverified.
#
# To force a variant, set IMMICH_ML_IMAGE_SUFFIX in profile.local.env, which is
# what engine/provision/30-gpu-runtime.sh tells you to edit. Known values: ""
# (cpu), -cuda, -openvino. Each has its own pinned entry above.
IMMICH_ML_MEM_LIMIT=2g
IMMICH_ML_THREADS=2
MACHINE_LEARNING_WORKERS=1

# Secrets are NEVER committed. Phase 60 generates them into
# /etc/sambuca/secrets/ and injects them into the rendered .env.
POSTGRES_PASSWORD=changeme-generated-on-device
IMMICH_DB_PASSWORD=changeme-generated-on-device
NEXTCLOUD_ADMIN_PASSWORD=changeme-generated-on-device
VAULTWARDEN_ADMIN_TOKEN=changeme-generated-on-device
OAUTH2_PROXY_COOKIE_SECRET=changeme-generated-on-device
POCKET_ID_ENCRYPTION_KEY=changeme-generated-on-device
BLINKO_JWT_SECRET=changeme-generated-on-device
SYNAPSE_REGISTRATION_SECRET=changeme-generated-on-device

# Watchtower: 05:00 daily, opt-in per container (see docker-compose.yml).
WATCHTOWER_SCHEDULE=0 0 5 * * *
