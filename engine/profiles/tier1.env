# shellcheck shell=bash
# sambuca :: tier 1 — heavy GPU (>= 24 GiB VRAM)
#
# The catalogue is DATA, not code: hardware-detect.sh sources this file and then
# trims the selection against the measured VRAM budget and free disk.
# Sizes are q4_K_M on-disk footprints in MiB, rounded up.

# Baseline: 24-39 GiB budget.
MODEL_CHAT="qwen2.5:32b-instruct-q4_K_M"          # ~20 GiB
MODEL_CODE="qwen2.5-coder:14b-instruct-q4_K_M"    # ~9  GiB
MODEL_VISION="llama3.2-vision:11b-instruct-q4_K_M" # ~8  GiB
MODEL_EMBED="nomic-embed-text"                     # ~0.3 GiB
MODEL_SET_EST_MB=38000

# Promoted when the measured budget clears TIER1_XL_BUDGET_MB.
TIER1_XL_BUDGET_MB=40000
MODEL_CHAT_XL="llama3.3:70b-instruct-q4_K_M"       # ~43 GiB
MODEL_SET_EST_XL_MB=61000

# Fallback when the disk guard drops the optional models.
MODEL_SET_EST_CHAT_ONLY_MB=20500
