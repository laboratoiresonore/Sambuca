# shellcheck shell=bash
# sambuca :: tier 3 — low/no GPU, capable CPU (>= 8 cores, >= 24 GiB RAM)
#
# Inference runs on the CPU, or partially offloaded to a small card. Expect
# 4-12 tok/s on an 8B q4. The stack stays fully usable; only generation is slow.

MODEL_CHAT="llama3.1:8b-instruct-q4_K_M"          # ~4.9 GiB
MODEL_CODE="qwen2.5-coder:7b-instruct-q4_K_M"     # ~4.7 GiB
MODEL_VISION="moondream:1.8b-v2-q4_K_M"           # ~1.7 GiB
MODEL_EMBED="nomic-embed-text"                     # ~0.3 GiB
MODEL_SET_EST_MB=11600

MODEL_SET_EST_CHAT_ONLY_MB=5200

# ── IMAGE GENERATION ────────────────────────────────────────────────────────
# OFF by default, and this is the honest call rather than a cautious one.
# FLUX on a CPU is minutes per picture, not seconds. Shipping it enabled would
# mean a novice types a sentence, waits four minutes, and concludes the
# appliance is broken.
#
# It also wants roughly 32 GiB of RAM to sit alongside the rest of the stack,
# which is above this tier's 24 GiB floor. The setup page offers it with both
# numbers attached rather than as a checkbox:
#   echo 'SAMBUCA_IMAGE_ENABLED=1' >> /etc/sambuca/profile.local.env
IMAGE_ENABLED=0
IMAGE_AVAILABLE_OPT_IN=1
IMAGE_OPT_IN_MIN_RAM_MB=32000
IMAGE_MODEL_NAME="FLUX.1-schnell (fp8, CPU)"
IMAGE_MODEL_LICENCE="Apache-2.0"
IMAGE_CHECKPOINT_URL="https://huggingface.co/Comfy-Org/flux1-schnell/resolve/main/flux1-schnell-fp8.safetensors"
IMAGE_CHECKPOINT_FILE="flux1-schnell-fp8.safetensors"
# Verified against the Hugging Face LFS oid on 2026-08-20. Phase 70 refuses to
# install a checkpoint whose digest does not match: a 16 GiB download over a
# home connection is exactly the kind of thing that arrives subtly truncated.
IMAGE_CHECKPOINT_SHA256="ead426278b49030e9da5df862994f25ce94ab2ee4df38b556ddddb3db093bf72"
IMAGE_WORKFLOW="flux-schnell.json"
IMAGE_STEPS=4
IMAGE_SET_EST_MB=16438
IMAGE_VRAM_ARGS="--cpu"
IMAGE_VRAM_MB=0
