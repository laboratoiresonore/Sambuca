# shellcheck shell=bash
# sambuca :: tier 4 — low resource (reclaimed hardware, thin clients, NAS boxes)
#
# The design goal here is that the SaaS-replacement half of the appliance
# (files, photos, passwords, notes) is fully functional, and the AI half is
# present but modest. No code or vision model is pulled: on this class of
# machine they would evict the chat model from RAM on every request.

MODEL_CHAT="llama3.2:3b-instruct-q4_K_M"          # ~2.0 GiB
MODEL_CODE=""
MODEL_VISION=""
MODEL_EMBED="nomic-embed-text"                     # ~0.3 GiB
MODEL_SET_EST_MB=2400

MODEL_SET_EST_CHAT_ONLY_MB=2400

# ── IMAGE GENERATION ────────────────────────────────────────────────────────
# Not offered at all, and not offered as an opt-in either. 16 GiB of weights to
# produce one picture every several minutes, on a machine whose actual job is
# to be a reliable file and photo server, is a bad trade — and it would compete
# for the RAM that keeps the rest of the appliance answering.
IMAGE_ENABLED=0
IMAGE_AVAILABLE_OPT_IN=0
IMAGE_SET_EST_MB=0
IMAGE_VRAM_MB=0
