# shellcheck shell=bash
# sambuca :: tier 2 — mid GPU (~12-23 GiB VRAM)
#
# 14B q4 leaves roughly 3-5 GiB of headroom on a 16 GiB card once the KV cache
# for an 8k context is resident. That headroom is why Immich ML stays on the CPU
# at this tier — see the arbitration block in hardware-detect.sh.

MODEL_CHAT="qwen2.5:14b-instruct-q4_K_M"          # ~9   GiB
MODEL_CODE="qwen2.5-coder:7b-instruct-q4_K_M"     # ~4.7 GiB
MODEL_VISION="llava:7b-v1.6-mistral-q4_K_M"       # ~4.7 GiB
MODEL_EMBED="nomic-embed-text"                     # ~0.3 GiB
MODEL_SET_EST_MB=18700

MODEL_SET_EST_CHAT_ONLY_MB=9300

# ── IMAGE GENERATION ────────────────────────────────────────────────────────
# FLUX.1-schnell, Apache-2.0. Chosen over SDXL (OpenRAIL++ carries use
# restrictions) and over FLUX.1-dev (licence:other, non-commercial) because the
# free-software audit in docs/IMAGES.md has to pass on the WEIGHTS too, not
# just on the containers.
#
# NOT fetched from black-forest-labs/FLUX.1-schnell: that repo is GATED and
# answers an anonymous fetch with 401, which would stall a walk-away install
# behind a Hugging Face account. Verified 2026-08-20. The Comfy-Org repackage
# is the same Apache-2.0 weights, ungated, and is one self-contained file.
#
# ONE MODEL AND ONE WORKFLOW ON EVERY TIER; only the memory mode changes. The
# GGUF quants are 5 GiB smaller and were the obvious choice until the loader
# turned out to be a third-party node with no releases and no commits since
# January. An unmaintained custom node inside an appliance that is supposed to
# run untouched for years is a worse trade than 5 GiB of disk.
#
# --lowvram is what makes a 17 GiB model run on a 12 GiB card: ComfyUI keeps
# the weights in system RAM and streams each block onto the card as it is
# needed. It costs seconds per picture and it is the difference between "works"
# and "out of memory" on the floor of this tier.
IMAGE_ENABLED=1
IMAGE_MODEL_NAME="FLUX.1-schnell (fp8, low-VRAM)"
IMAGE_MODEL_LICENCE="Apache-2.0"
IMAGE_CHECKPOINT_URL="https://huggingface.co/Comfy-Org/flux1-schnell/resolve/main/flux1-schnell-fp8.safetensors"
IMAGE_CHECKPOINT_FILE="flux1-schnell-fp8.safetensors"
# Verified against the Hugging Face LFS oid on 2026-08-20. Phase 70 refuses to
# install a checkpoint whose digest does not match: a 16 GiB download over a
# home connection is exactly the kind of thing that arrives subtly truncated.
IMAGE_CHECKPOINT_SHA256="ead426278b49030e9da5df862994f25ce94ab2ee4df38b556ddddb3db093bf72"
IMAGE_WORKFLOW="flux-schnell.json"
IMAGE_STEPS=4
IMAGE_SET_EST_MB=16438
IMAGE_VRAM_ARGS="--lowvram"
IMAGE_VRAM_MB=11500
IMAGE_CORESIDENT_BUDGET_MB=40000
